# CabinConnect — editor conventions across the entire repo (process + product).
# Delivered by U-T04.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,csproj,sln,props,targets}]
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
