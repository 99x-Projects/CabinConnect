# Copy this file to .env.local and fill in environment-specific values.
# .env.development holds local-dev defaults and is committed.

VITE_API_BASE_URL=http://localhost:5000

# Supabase (dev-cloud). Get these from your Supabase project: Project Settings -> API.
# NEVER commit the service_role key. Only the anon key belongs on the client.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Feature flags. Only the exact lowercase string "true" enables the flag; everything else (unset, "1", "TRUE", "yes") is OFF.
VITE_FF_CABIN_PROFILE_MVP=false
