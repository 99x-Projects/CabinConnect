{
  "$comment": "CabinConnect design tokens. Source of truth — consumed by css-vars.css (runtime) and tailwind.config.ts (build-time). See ai-dlc/ops/inception/dfd/DFD.md §2.",
  "color": {
    "primary": "#2d5a3d",
    "primary-fg": "#f7f5f0",
    "accent": "#e07b3c",
    "surface": "#f7f5f0",
    "surface-raised": "#ffffff",
    "border": "#e8e6e0",
    "text": "#2a2a2a",
    "text-muted": "#6c6c6c",
    "error": "#b03a2e",
    "success": "#2e7d32",
    "warning": "#d6a012",
    "offline": "#6c6c6c"
  },
  "font": {
