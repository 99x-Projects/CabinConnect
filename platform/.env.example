# =============================================================================
# CabinConnect — environment variable template
# =============================================================================
# Copy this file to .env.local and fill in the values from your local Supabase
# emulator (`supabase start` prints them) or your project dashboard.
#
# .env.local is git-ignored and must never be committed.
# Never put real secret values in this file.
#
# For production, these values come from GitHub Environment Secrets in the
# `dev`, `staging`, `prod` GitHub Environments — see
# `ai-dlc/ops/operate/runbooks/rotate-supabase-key.md` for the secret rotation
# runbook and the full list of expected secret names.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — backend-only (NEVER expose to the frontend)
# -----------------------------------------------------------------------------
# The service-role key bypasses RLS. Backend-only by definition. Leaking this
# to the frontend bundle is a P0 incident.

SUPABASE_URL=https://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-emulator-service-role-key


# -----------------------------------------------------------------------------
# Supabase — frontend-safe (Vite-exposed; bundled into the React app)
# -----------------------------------------------------------------------------
# These values are PUBLIC by design. The anon key is rate-limited and gated by
# RLS — it cannot bypass community-scoping.

VITE_SUPABASE_URL=https://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-emulator-anon-key


# -----------------------------------------------------------------------------
# Backend API (.NET 8)
# -----------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5125


# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:5125


# -----------------------------------------------------------------------------
# Localization defaults
# -----------------------------------------------------------------------------
# Resolution chain per U-010: profile locale → Accept-Language → DEFAULT_LOCALE.

DEFAULT_LOCALE=nb-NO
