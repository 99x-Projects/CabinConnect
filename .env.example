# CabinConnect — environment variables
# Copy this file to .env.local (frontend) or appsettings.Development.json (API)
# and fill in values from your Supabase project dashboard.
# NEVER commit the filled-in values.

# ── Supabase (get from https://supabase.com/dashboard → Project Settings → API) ──
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>        # Settings → API → JWT Secret

# ── Frontend (Vite — prefix with VITE_ to expose to browser) ─────────────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_API_BASE_URL=https://localhost:7001       # .NET API local dev URL

# ── API (set in appsettings.Development.json or via dotnet user-secrets) ──────
# Supabase__Url=https://<your-project-ref>.supabase.co
# Supabase__JwtSecret=<your-jwt-secret>
# Cors__AllowedOrigins__0=http://localhost:5173
# ConnectionStrings__DefaultConnection=Host=<db-host>;Database=postgres;Username=postgres;Password=<db-password>
